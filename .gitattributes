# Normalise to LF in the repository; check out native on Windows.
* text=auto eol=lf

# Files that must keep LF even on a Windows checkout - they run inside Linux images.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf

*.png binary
*.jpg binary
*.ico binary
