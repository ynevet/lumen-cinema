# Copy to .env for local (non-Docker) development:  cp .env.example .env
# docker-compose.yml supplies its own values, so .env is only needed when you run
# `npm run dev` on the host against the Dockerised database.

# ---- Database -------------------------------------------------------------
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema
POSTGRES_DB=cinema
POSTGRES_PORT=5432
DATABASE_URL=postgres://cinema:cinema@localhost:5432/cinema

# ---- API ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Change this for any deployment that is not a laptop.
JWT_SECRET=dev-only-secret-change-me-please
JWT_TTL_MINUTES=720

# Business rules
HOLD_MINUTES=15
MAX_SEATS_PER_RESERVATION=10
EXPIRY_SWEEP_MS=15000

# Startup behaviour
RUN_MIGRATIONS=true
RUN_SEED=true

# Comma separated origins, or * to allow any (dev convenience)
CORS_ORIGIN=*

# ---- Published ports (Docker) ---------------------------------------------
API_PORT=4000
WEB_PORT=8080
